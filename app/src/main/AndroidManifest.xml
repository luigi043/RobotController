<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ── Classic Bluetooth (API ≤ 30) ────────────────────────────────────── -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30"/>
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30"/>

    <!-- Location was required for BT scanning on Android 10 / 11 -->
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30"/>
    <uses-permission
        android:name="android.permission.ACCESS_COARSE_LOCATION"
        android:maxSdkVersion="30"/>

    <!-- ── Modern Bluetooth (API ≥ 31 / Android 12+) ───────────────────────── -->
    <!--   neverForLocation: we only use paired devices, not nearby scanning   -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"/>
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"/>

    <!-- ── Vibration feedback ───────────────────────────────────────────────── -->
    <uses-permission android:name="android.permission.VIBRATE"/>

    <!-- Declare Bluetooth hardware as required -->
    <uses-feature
        android:name="android.hardware.bluetooth"
        android:required="true"/>

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_robot"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.RobotController">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

    </application>

</manifest>
